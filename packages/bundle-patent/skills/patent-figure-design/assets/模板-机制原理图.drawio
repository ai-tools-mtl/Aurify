<mxfile host="app.diagrams.net">
  <diagram id="tpl-mechanism" name="机制原理图">
    <mxGraphModel dx="900" dy="700" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1440" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="封装侧（第一子系统）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1;fontSize=24;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="40" y="60" width="540" height="580" as="geometry"/></mxCell>
        <mxCell id="c2" value="发布产物（数据对象解剖）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1;fontSize=24;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="650" y="140" width="300" height="520" as="geometry"/></mxCell>
        <mxCell id="c3" value="恢复侧（第二子系统）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1;fontSize=24;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="1010" y="60" width="390" height="680" as="geometry"/></mxCell>
        <mxCell id="b1" value="机制拆分（式2）&#10;随机生成份额 A、B，合成 X = H(A‖B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="100" y="120" width="440" height="80" as="geometry"/></mxCell>
        <mxCell id="b2" value="通路一封装&#10;产物甲 = 封装方案(公开参数, 策略, A)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="100" y="250" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="b3" value="通路二掩蔽（式3）&#10;选锚点，共享锚点 = g(锚点)&#10;令牌 = B ⊕ H(锚点·公钥)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="100" y="420" width="440" height="170" as="geometry"/></mxCell>
        <mxCell id="s1" value="产物甲（密文/封装产物）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="670" y="285" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="共享锚点/公共参数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="670" y="375" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="授权列表 {令牌}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="670" y="465" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="受保护数据 = Enc_X(本体)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="670" y="555" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="d1" value="第一恢复门&#10;条件满足时以用户密钥&#10;对产物甲解密，恢复份额 A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="310" height="200" as="geometry"/></mxCell>
        <mxCell id="d2" value="第二恢复门&#10;中间值 = 私钥·共享锚点（式4）&#10;B = 令牌 ⊕ H(中间值)（式5）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=20;fontFamily=SimSun" vertex="1" parent="1"><mxGeometry x="1050" y="375" width="310" height="150" as="geometry"/></mxCell>
